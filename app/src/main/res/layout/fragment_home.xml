<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    tools:context=".presentation.fragment.HomeFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="28dp"
                app:cardElevation="6dp"
                app:strokeColor="@color/md_theme_outlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/position_me"
                        android:textColor="@color/md_theme_onSurface"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/sloganText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/home_start_from_recording"
                        android:textColor="@color/md_theme_onSurfaceVariant"
                        android:textSize="16sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/startStopButton"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="28dp"
                        android:backgroundTint="@color/md_theme_primary"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/start_recording"
                        android:textColor="@color/md_theme_onPrimary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:cornerRadius="28dp"
                        app:icon="@drawable/ic_baseline_directions_walk_24"
                        app:iconGravity="textStart"
                        app:iconPadding="12dp"
                        app:iconTint="@color/md_theme_onPrimary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/gnssStatusTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/gnss_disabled"
                android:textColor="@color/md_theme_error"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="@string/quick_tools"
                android:textColor="@color/md_theme_onSurface"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.gridlayout.widget.GridLayout
                android:id="@+id/buttonGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                app:columnCount="2"
                app:rowCount="2">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/filesButton"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="148dp"
                    android:layout_margin="8dp"
                    android:backgroundTint="@color/home_tile_history"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingTop="24dp"
                    android:paddingBottom="24dp"
                    android:text="@string/files"
                    android:textAllCaps="false"
                    android:textColor="@color/md_theme_onSurface"
                    android:textSize="17sp"
                    app:cornerRadius="24dp"
                    app:icon="@drawable/ic_baseline_folder_24"
                    app:iconGravity="textTop"
                    app:iconPadding="18dp"
                    app:iconSize="34dp"
                    app:iconTint="@color/md_theme_onSurface"
                    app:layout_columnWeight="1"
                    app:layout_rowWeight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/measurementButton"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="148dp"
                    android:layout_margin="8dp"
                    android:backgroundTint="@color/home_tile_live"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingTop="24dp"
                    android:paddingBottom="24dp"
                    android:text="@string/measurements"
                    android:textAllCaps="false"
                    android:textColor="@color/md_theme_onSurface"
                    android:textSize="17sp"
                    app:cornerRadius="24dp"
                    app:icon="@drawable/ic_baseline_data_array_24"
                    app:iconGravity="textTop"
                    app:iconPadding="18dp"
                    app:iconSize="34dp"
                    app:iconTint="@color/md_theme_onSurface"
                    app:layout_columnWeight="1"
                    app:layout_rowWeight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sensorInfoButton"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="148dp"
                    android:layout_margin="8dp"
                    android:backgroundTint="@color/home_tile_info"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingTop="24dp"
                    android:paddingBottom="24dp"
                    android:text="@string/info"
                    android:textAllCaps="false"
                    android:textColor="@color/md_theme_onSurface"
                    android:textSize="17sp"
                    app:cornerRadius="24dp"
                    app:icon="@drawable/ic_baseline_info_24"
                    app:iconGravity="textTop"
                    app:iconPadding="18dp"
                    app:iconSize="34dp"
                    app:iconTint="@color/md_theme_onSurface"
                    app:layout_columnWeight="1"
                    app:layout_rowWeight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/indoorButton"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="148dp"
                    android:layout_margin="8dp"
                    android:backgroundTint="@color/home_tile_indoor"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingTop="24dp"
                    android:paddingBottom="24dp"
                    android:text="Indoor Map"
                    android:textAllCaps="false"
                    android:textColor="@color/md_theme_onSurface"
                    android:textSize="17sp"
                    app:cornerRadius="24dp"
                    app:icon="@drawable/ic_baseline_building_24"
                    app:iconGravity="textTop"
                    app:iconPadding="18dp"
                    app:iconSize="34dp"
                    app:iconTint="@color/md_theme_onSurface"
                    app:layout_columnWeight="1"
                    app:layout_rowWeight="1" />
            </androidx.gridlayout.widget.GridLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="28dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/md_theme_outlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/map_preview_title"
                        android:textColor="@color/md_theme_onSurface"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/mapFragmentContainer"
                        android:name="com.google.android.gms.maps.SupportMapFragment"
                        android:layout_width="match_parent"
                        android:layout_height="230dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>
