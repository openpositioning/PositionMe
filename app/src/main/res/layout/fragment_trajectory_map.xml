<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/trajectory_map_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The actual map container -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/trajectoryMap"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Overlaid controls for map visualization -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:padding="18dp"
        app:cardBackgroundColor="@color/md_theme_surfaceContainer"
        app:cardElevation="4dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.MediumComponent"
        app:layout_anchor="@id/trajectoryMap"
        app:layout_anchorGravity="top|start">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"
            android:gravity="center">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/gnssSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gnssSwitch" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/autoFloor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_floor" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/statsSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live Stats" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/lineColorButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/red"
                android:textColor="@color/md_theme_onPrimary"
                android:text="@string/color"
                app:elevation="5dp"/>

            <Spinner
                android:id="@+id/mapSwitchSpinner"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="0dp"
                android:layout_marginTop="8dp"
                android:background="@android:color/white"
                android:spinnerMode="dropdown"
                app:layout_constraintTop_toTopOf="parent"
                android:elevation="5dp"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Live Stats Panel (top-right) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/statsPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:padding="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/md_theme_surfaceContainer"
        app:cardElevation="4dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.MediumComponent"
        app:layout_anchor="@id/trajectoryMap"
        app:layout_anchorGravity="top|end">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live Stats"
                android:textStyle="bold"
                android:textSize="14sp"
                android:paddingBottom="8dp"
                android:textColor="?attr/colorPrimary" />

            <TextView
                android:id="@+id/statsSteps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚶 Steps: 0"
                android:textSize="12sp"
                android:paddingVertical="2dp" />

            <TextView
                android:id="@+id/statsDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📏 Distance: 0.0m"
                android:textSize="12sp"
                android:paddingVertical="2dp" />

            <TextView
                android:id="@+id/statsTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱️ Time: 00:00"
                android:textSize="12sp"
                android:paddingVertical="2dp" />

            <TextView
                android:id="@+id/statsSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 Speed: 0.0 m/s"
                android:textSize="12sp"
                android:paddingVertical="2dp" />

            <TextView
                android:id="@+id/statsWifi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📶 WiFi: 0 APs"
                android:textSize="12sp"
                android:paddingVertical="2dp" />

            <TextView
                android:id="@+id/statsBle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔵 BLE: 0 devices"
                android:textSize="12sp"
                android:paddingVertical="2dp" />

            <TextView
                android:id="@+id/statsGps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛰️ GPS: N/A"
                android:textSize="12sp"
                android:paddingVertical="2dp" />

            <TextView
                android:id="@+id/statsFloor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏢 Floor: N/A"
                android:textSize="12sp"
                android:paddingVertical="2dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Floating action buttons for floor control and test point marker -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Test Point Marker Button (bottom-left) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/addTestPointButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:src="@drawable/ic_baseline_add_location_24"
            app:backgroundTint="#FF5722"
            app:tint="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:contentDescription="@string/add_test_point" />

        <!-- Floor Down Button (bottom-right) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/floorDownButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:src="@android:drawable/arrow_down_float"
            app:backgroundTint="@color/md_theme_primary"
            app:tint="@color/md_theme_onPrimary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:contentDescription="@string/floor_down" />

        <!-- Floor Up Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/floorUpButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:src="@android:drawable/arrow_up_float"
            app:backgroundTint="@color/md_theme_primary"
            app:tint="@color/md_theme_onPrimary"
            app:layout_constraintBottom_toTopOf="@id/floorDownButton"
            app:layout_constraintEnd_toEndOf="parent"
            android:contentDescription="@string/floor_up" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
