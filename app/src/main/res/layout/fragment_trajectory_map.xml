<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/trajectory_map_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The actual map container -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/trajectoryMap"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Overlaid controls for map visualization -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:padding="18dp"
        app:cardBackgroundColor="@color/md_theme_surfaceContainer"
        app:cardElevation="4dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.MediumComponent"
        app:layout_anchor="@id/trajectoryMap"
        app:layout_anchorGravity="top|start">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"
            android:gravity="start">

            <!-- ── Collapse/Expand header ── -->
            <LinearLayout
                android:id="@+id/controlCardHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mapControls"
                    android:textColor="@color/md_theme_onSurface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/controlCardCollapseIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/dropdownSymbol"
                    android:textColor="@color/md_theme_onSurface"
                    android:textSize="15sp" />

            </LinearLayout>

            <!-- ── Collapsible content ── -->
            <LinearLayout
                android:id="@+id/controlCardContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/gnssSwitch"
                    android:layout_width="200dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_height="25dp"
                    android:checked="false"
                    android:text="@string/gnssSwitch" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/autoFloor"
                    android:layout_width="200dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_height="25dp"
                    android:checked="false"
                    android:text="@string/auto_floor" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/particleCloudSwitch"
                    android:layout_width="200dp"
                    android:layout_height="25dp"
                    android:checked="false"
                    android:drawableStart="@android:drawable/ic_menu_compass"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="-5dp"
                    android:text="@string/particleCloud" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:background="@color/md_theme_onSurface"
                    android:alpha="0.15" />

                <!-- Controls visibility of the blue GNSS path polyline independently of the marker -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/gnssPathSwitch"
                    android:layout_width="200dp"
                    android:layout_height="25dp"
                    android:checked="false"
                    android:drawableStart="@android:drawable/ic_menu_directions"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="-5dp"
                    android:text="@string/gnssPath" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/smoothingSwitch"
                    android:layout_width="200dp"
                    android:layout_height="25dp"
                    android:checked="false"
                    android:drawableStart="@android:drawable/ic_menu_directions"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="-5dp"
                    android:text="@string/smoothPath" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/fusedPdrSwitch"
                    android:layout_width="200dp"
                    android:layout_height="25dp"
                    android:checked="false"
                    android:drawableStart="@android:drawable/ic_menu_directions"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="-5dp"
                    android:text="@string/pdrPath" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:background="@color/md_theme_onSurface"
                    android:alpha="0.15" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/gnssDotSwitch"
                    android:layout_width="200dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_height="25dp"
                    android:checked="false"
                    android:text="🔵 GNSS dots" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/wifiDotSwitch"
                    android:layout_width="200dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_height="25dp"
                    android:checked="false"
                    android:text="🟠 WiFi dots" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/pdrDotSwitch"
                    android:layout_width="200dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_height="25dp"
                    android:checked="false"
                    android:text="🟢 PDR dots" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/lineColorButton"
                    android:layout_width="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_height="45dp"
                    android:backgroundTint="@color/red"
                    android:text="@string/color"
                    android:textColor="@color/md_theme_onPrimary"
                    app:elevation="5dp" />

                <Spinner
                    android:id="@+id/mapSwitchSpinner"
                    android:layout_width="80dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:background="@android:color/white"
                    android:elevation="5dp"
                    android:spinnerMode="dropdown" />

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>


    </com.google.android.material.card.MaterialCardView>

    <!-- Floating action buttons for floor control, properly spaced -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Floor Down Button (Bottom-most) -->

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/floorDownButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:layout_marginEnd="36dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/floor_down"
            android:src="@android:drawable/arrow_down_float"
            app:backgroundTint="@android:color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="@android:color/black" />

        <!-- Floor Label (Middle) -->

        <TextView
            android:id="@+id/floorLabel"
            android:layout_width="93dp"
            android:layout_height="36dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="@android:color/white"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/floor_default"
            android:textColor="@android:color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/floorDownButton"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Floor Up Button (Top-most) -->

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/floorUpButton"
            android:layout_width="65dp"
            android:layout_height="59dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="20dp"
            android:contentDescription="@string/floor_up"
            android:src="@android:drawable/arrow_up_float"
            app:backgroundTint="@android:color/white"
            app:layout_constraintBottom_toTopOf="@+id/floorLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="@android:color/black" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.coordinatorlayout.widget.CoordinatorLayout>
