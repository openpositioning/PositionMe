<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/trajectory_map_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/trajectoryMap"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:gravity="top"
        android:orientation="horizontal"
        app:layout_anchor="@id/trajectoryMap"
        app:layout_anchorGravity="top|start">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#F7FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Map Controls"
                    android:textColor="@android:color/black"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/mapControlsContent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/gnssSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gnssSwitch" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/autoFloor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_floor" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/showWifiSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="📶 Show WiFi" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/showPdrSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="👣 Show PDR" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/lineColorButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Red"
                        android:textColor="@android:color/white"
                        app:backgroundTint="@android:color/holo_red_dark"
                        app:elevation="5dp" />

                    <Spinner
                        android:id="@+id/mapSwitchSpinner"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@android:color/white"
                        android:spinnerMode="dropdown" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleControls"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:text="Hide"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            app:backgroundTint="#546E7A" />

    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/mapActionButtons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/selectedVenueText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap a blue building outline to select a building"
                android:background="#B3FFFFFF"
                android:textColor="@android:color/black"
                android:padding="6dp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/indoorLoadingIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:visibility="gone"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFindActualMap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Display Actual Maps"
                android:layout_marginBottom="8dp"
                app:backgroundTint="?attr/colorPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleAdjustMap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Adjust Map"
                android:visibility="gone"
                android:layout_marginBottom="8dp"
                app:backgroundTint="#546E7A" />

            <LinearLayout
                android:id="@+id/calibrationPanel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#CCFFFFFF"
                android:padding="8dp"
                android:visibility="gone"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/calibrationTargetText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Target:"
                    android:textColor="@android:color/black"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/calibrationValueText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="x=0.000 y=0.000 w=1.000 h=1.000"
                    android:textColor="@android:color/black"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCalibrationTarget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Switch Target"
                    android:visibility="gone"
                    android:layout_marginBottom="6dp"
                    app:backgroundTint="#607D8B" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCalibrateUp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Up"
                        android:minWidth="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCalibrateDown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Down"
                        android:minWidth="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:layout_marginStart="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCalibrateLeft"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Left"
                        android:minWidth="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:layout_marginStart="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCalibrateRight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Right"
                        android:minWidth="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWidthMinus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="W-"
                        android:minWidth="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWidthPlus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="W+"
                        android:minWidth="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:layout_marginStart="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHeightMinus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="H-"
                        android:minWidth="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:layout_marginStart="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHeightPlus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="H+"
                        android:minWidth="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveCalibration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Save"
                        android:minWidth="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        app:backgroundTint="#2E7D32" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResetCalibration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reset"
                        android:minWidth="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:layout_marginStart="4dp"
                        app:backgroundTint="#C62828" />
                </LinearLayout>

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFindIndoorMap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Find Indoor Maps"
                app:backgroundTint="?attr/colorPrimary" />
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/floorDownButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:src="@android:drawable/arrow_down_float"
            app:backgroundTint="?attr/colorPrimary"
            app:tint="@android:color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/floorLabel"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="#E0E0E0"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="G"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/floorDownButton"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/floorUpButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="28dp"
            android:src="@android:drawable/arrow_up_float"
            app:backgroundTint="?attr/colorPrimary"
            app:tint="@android:color/white"
            app:layout_constraintBottom_toTopOf="@+id/floorLabel"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>