<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/trajectory_map_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The actual map container -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/trajectoryMap"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/mapInteractionBlocker"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:background="#01000000"
        android:elevation="2dp" />

    <!-- Overlaid controls: collapsible toolbar panel + toggle tab -->
    <LinearLayout
        android:id="@+id/toolbarContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="10dp"
        android:clipChildren="false"
        android:scaleX="0.80"
        android:scaleY="0.80"
        android:transformPivotX="0dp"
        android:transformPivotY="0dp"
        android:elevation="12dp"
        app:layout_anchor="@id/trajectoryMap"
        app:layout_anchorGravity="top|start">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/controlPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.85"
            android:padding="18dp"
            app:cardBackgroundColor="@color/md_theme_surfaceContainer"
            app:cardElevation="4dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.MediumComponent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp"
                android:minWidth="200dp">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/compassSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:singleLine="true"
                    android:text="@string/compassSwitch" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/weatherSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:singleLine="true"
                    android:text="@string/weatherSwitch" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/gnssSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:singleLine="true"
                    android:text="@string/gnssSwitch" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/wifiSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:singleLine="true"
                    android:text="@string/wifiSwitch" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/estimatedSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:singleLine="true"
                    android:text="@string/estimatedSwitch" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/pdrPathSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:singleLine="true"
                    android:text="@string/pdrPathSwitch" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/fusedPathSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:singleLine="true"
                    android:text="@string/fusedPathSwitch" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/smoothPathSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:singleLine="true"
                    android:text="@string/smoothPathSwitch" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/autoFloor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:singleLine="true"
                    android:text="@string/auto_floor" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/navigatingSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:singleLine="true"
                    android:text="@string/navigatingSwitch" />

                <Spinner
                    android:id="@+id/mapSwitchSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@android:color/white"
                    android:spinnerMode="dropdown"
                    android:elevation="5dp"/>

                <LinearLayout
                    android:id="@+id/calibrationMapStyleList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:background="@android:color/white"
                    android:paddingVertical="4dp">

                    <TextView
                        android:id="@+id/mapStyleHybridOption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp"
                        android:text="@string/hybrid"
                        android:textColor="@color/md_theme_onSurface"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/mapStyleNormalOption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp"
                        android:text="@string/normal"
                        android:textColor="@color/md_theme_onSurface"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/mapStyleSatelliteOption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp"
                        android:text="@string/satellite"
                        android:textColor="@color/md_theme_onSurface"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Toggle tab: tap to collapse/expand the control panel -->
        <ImageView
            android:id="@+id/toolbarToggle"
            android:layout_width="24dp"
            android:layout_height="48dp"
            android:layout_gravity="top"
            android:background="@drawable/toggle_tab_bg"
            android:scaleType="center"
            android:src="@drawable/ic_chevron_left"
            android:contentDescription="Toggle toolbar" />

    </LinearLayout>

    <!-- Floating action buttons for floor control, properly spaced -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/floorDownButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:src="@android:drawable/arrow_down_float"
            android:alpha="0.85"
            app:fabSize="mini"
            app:backgroundTint="#CE93D8"
            app:tint="@android:color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:contentDescription="@string/floor_down" />

        <TextView
            android:id="@+id/floorLabel"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:background="@drawable/floor_label_bg"
            android:gravity="center"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="G"
            android:alpha="0.85"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/floorDownButton"
            app:layout_constraintStart_toStartOf="@id/floorDownButton"
            app:layout_constraintEnd_toEndOf="@id/floorDownButton" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/floorUpButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:contentDescription="@string/floor_up"
            android:src="@android:drawable/arrow_up_float"
            android:alpha="0.85"
            app:fabSize="mini"
            app:backgroundTint="#CE93D8"
            app:tint="@android:color/white"
            app:layout_constraintBottom_toTopOf="@+id/floorLabel"
            app:layout_constraintStart_toStartOf="@id/floorDownButton"
            app:layout_constraintEnd_toEndOf="@id/floorDownButton" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_begin="607dp" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="395dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
