<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/trajectory_map_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The actual map container -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/trajectoryMap"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Overlaid controls for map visualization -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mapControlsCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:padding="18dp"
        app:cardBackgroundColor="@color/md_theme_surfaceContainer"
        app:cardElevation="4dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.MediumComponent"
        app:layout_anchor="@id/trajectoryMap"
        app:layout_anchorGravity="top|start">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/alwaysOnLegend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/location_services_on"
                android:textColor="@color/md_theme_onSurface"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fusedLegend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/legend_fused_track"
                android:textColor="#D32F2F"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/gnssLegend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/legend_gnss_points"
                android:textColor="#1976D2"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/wifiLegend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/legend_wifi_points"
                android:textColor="#00897B"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/pdrLegend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/legend_pdr_points"
                android:textColor="#FF6F00"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/mapSwitchSpinner"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="@android:color/white"
                android:elevation="5dp"
                android:spinnerMode="dropdown"
                app:layout_constraintTop_toTopOf="parent" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Floating action buttons for floor control, properly spaced -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/floorDownButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:src="@android:drawable/arrow_down_float"
            app:fabSize="mini"
            app:backgroundTint="@color/md_theme_primary"
            app:tint="@color/md_theme_onPrimary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:contentDescription="@string/floor_down" />

        <TextView
            android:id="@+id/floorLabel"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/floor_label_bg"
            android:gravity="center"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="G"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/floorDownButton"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/floorUpButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="14dp"
            android:contentDescription="@string/floor_up"
            android:src="@android:drawable/arrow_up_float"
            app:fabSize="mini"
            app:backgroundTint="@color/md_theme_primary"
            app:layout_constraintBottom_toTopOf="@+id/floorLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="@color/md_theme_onPrimary" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_begin="607dp" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="395dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
