<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/trajectory_map_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The actual map container -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/trajectoryMap"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Overlaid controls for map visualization -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:padding="18dp"
        app:cardBackgroundColor="@color/md_theme_surfaceContainer"
        app:cardElevation="4dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.MediumComponent"
        app:layout_anchor="@id/trajectoryMap"
        app:layout_anchorGravity="top|start">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"
            android:gravity="center">

            <ImageButton
                android:id="@+id/toggleControlsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@android:drawable/arrow_up_float"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Toggle controls"
                android:padding="4dp" />

            <LinearLayout
                android:id="@+id/switchesPanel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/gnssSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gnssSwitch" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/autoFloor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_floor" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/smoothSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/smooth_toggle" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/pdrPathSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="@string/pdr_path_toggle" />
 
            <com.google.android.material.button.MaterialButton
                android:id="@+id/lineColorButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/red"
                android:textColor="@color/md_theme_onPrimary"
                android:text="@string/color"
                app:elevation="5dp"/>

            <Spinner
                android:id="@+id/mapSwitchSpinner"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="0dp"
                android:layout_marginTop="8dp"
                android:background="@android:color/white"
                android:spinnerMode="dropdown"
                app:layout_constraintTop_toTopOf="parent"
                android:elevation="5dp"/>

            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Colour legend card — bottom-start corner -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        app:cardBackgroundColor="@color/md_theme_surfaceContainer"
        app:cardElevation="3dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.MediumComponent"
        app:layout_anchor="@id/trajectoryMap"
        app:layout_anchorGravity="bottom|start">
 
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">
 
            <!-- GNSS row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">
                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/legend_dot"
                    android:backgroundTint="#2196F3"
                    android:layout_marginEnd="6dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/legend_gnss"
                    android:textSize="11sp" />
            </LinearLayout>
 
            <!-- WiFi row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">
                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/legend_dot"
                    android:backgroundTint="#FF9800"
                    android:layout_marginEnd="6dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/legend_wifi"
                    android:textSize="11sp" />
            </LinearLayout>
 
            <!-- PDR row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">
                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/legend_dot"
                    android:backgroundTint="#F44336"
                    android:layout_marginEnd="6dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/legend_pdr"
                    android:textSize="11sp" />
            </LinearLayout>
 
            <!-- Fused row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/legend_dot"
                    android:backgroundTint="#9C27B0"
                    android:layout_marginEnd="6dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/legend_fused"
                    android:textSize="11sp" />
            </LinearLayout>
 
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
 
    <!-- Floating action buttons for floor control, properly spaced -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/floorDownButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:src="@android:drawable/arrow_down_float"
            app:backgroundTint="@color/md_theme_primary"
            app:tint="@color/md_theme_onPrimary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:contentDescription="@string/floor_down" />

        <TextView
            android:id="@+id/floorLabel"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/floor_label_bg"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="G"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/floorDownButton"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/floorUpButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="28dp"
            android:contentDescription="@string/floor_up"
            android:src="@android:drawable/arrow_up_float"
            app:backgroundTint="@color/md_theme_primary"
            app:layout_constraintBottom_toTopOf="@+id/floorLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="@color/md_theme_onPrimary" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_begin="607dp" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="395dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
