<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/trajectory_map_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The actual map container -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/trajectoryMap"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Overlaid controls for map visualization -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:padding="18dp"
        app:cardBackgroundColor="@color/md_theme_surfaceContainer"
        app:cardElevation="4dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.MediumComponent"
        app:layout_anchor="@id/trajectoryMap"
        app:layout_anchorGravity="top|start">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"
            android:gravity="start">

            <!-- ── Collapse/Expand header ── -->
            <LinearLayout
                android:id="@+id/controlCardHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Map Controls"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurface" />

                <TextView
                    android:id="@+id/controlCardCollapseIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="▶"
                    android:textSize="11sp"
                    android:textColor="@color/md_theme_onSurface" />

            </LinearLayout>

            <!-- ── Collapsible content ── -->
            <LinearLayout
                android:id="@+id/controlCardContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/gnssSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:text="@string/gnssSwitch" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/autoFloor"
                    android:layout_width="wrap_content"
                    android:layout_height="23dp"
                    android:text="@string/auto_floor" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/smoothingSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="23dp"
                    android:checked="false"
                    android:text="Smooth fused path" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/fusedPdrSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:checked="true"
                    android:text="Show PDR path" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/particleCloudSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:checked="false"
                    android:text="Particle cloud" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="4dp"
                    android:background="@color/md_theme_onSurface"
                    android:alpha="0.15" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Show dots"
                    android:textSize="11sp"
                    android:textColor="@color/md_theme_onSurface"
                    android:alpha="0.6"
                    android:layout_marginBottom="2dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/gnssDotSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="🔵 GNSS dots" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/wifiDotSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="🟠 WiFi dots" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/pdrDotSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="🟢 PDR dots" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/lineColorButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:backgroundTint="@color/red"
                    android:text="@string/color"
                    android:textColor="@color/md_theme_onPrimary"
                    app:elevation="5dp" />

                <Spinner
                    android:id="@+id/mapSwitchSpinner"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:background="@android:color/white"
                    android:elevation="5dp"
                    android:spinnerMode="dropdown" />

            </LinearLayout>
        </LinearLayout>
