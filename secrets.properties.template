# ⚠️ 重要: 这是 secrets.properties 的模板文件
# 请复制此文件为 "secrets.properties" 并填入你的实际值
# 此模板文件可以安全地提交到 Git

# Google Maps API Key
# 获取方式: https://cloud.google.com/docs/authentication/api-keys
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# OpenPositioning Master Key (固定值)
# 不要修改此值
OPENPOSITIONING_MASTER_KEY=ewireless

# OpenPositioning API Key
# 获取方式: 在 openpositioning.org 上注册账户并获取 API Key
# 示例值用于本项目: Fbduaqg2iffH51lef1Eh7A
OPENPOSITIONING_API_KEY=YOUR_API_KEY_HERE
